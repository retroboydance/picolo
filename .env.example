# ============================================================================
# LLRE Cross-Platform Environment Configuration (.env.example)
# Copy this file to `.env` on each machine (Windows Work Laptop / Linux GPU Laptop)
# ============================================================================

# --- Compute Backend & Device Selection ---
# Options: auto | cpu | gpu | tpu
# "auto" selects CUDA GPU on Linux if available, and falls back to CPU on Windows.
LLRE_BACKEND=auto

# Enable 64-bit integer/float precision in JAX (REQUIRED for 64-way bit-parallel ALU registers)
LLRE_ENABLE_X64=1

# Local directory for persistent XLA compilation cache (speeds up startup per OS)
LLRE_XLA_CACHE_DIR=.jax_cache

# --- Linux Dedicated GPU (CUDA) Tuning ---
# Prevent JAX from pre-allocating 75% of VRAM upfront on your Linux laptop
XLA_PYTHON_CLIENT_PREALLOCATE=false
XLA_PYTHON_CLIENT_MEM_FRACTION=0.80

# --- Windows / Linux Multi-Core CPU Tuning ---
# Number of host CPU device threads for XLA intra-op parallelism (0 = auto-detect cores)
LLRE_CPU_THREADS=0

# --- Tier 4 Sandbox Execution Scaling ---
# Options: auto | integer (e.g., 4096 on CPU, 65536 on GPU)
# When set to "auto", defaults to 4096 on CPU and 65536 on CUDA GPU.
LLRE_BATCH_SIZE=auto

# Maximum instruction depth (L) for candidate programs [B, L, 4]
LLRE_MAX_STEPS=16

# Number of 64-bit word test vectors in ALU mode
LLRE_NUM_ALU_TESTS=64

# --- Tier 2 Continuous Latent Reasoning Core (JEPA + SIGReg) ---
LLRE_LATENT_DIM=64
LLRE_SIGREG_PROJECTIONS=64
LLRE_SIGREG_WEIGHT=0.1
LLRE_TRAJECTORY_STEPS=12
LLRE_TRAJECTORY_LR=0.08
LLRE_RANDOM_SEED=42

# --- Tier 5 Formal Solver (SMT Verification) ---
# Options: auto | z3 | symbolic
# "auto" uses z3-solver if installed, otherwise uses the native symbolic bit-vector solver.
LLRE_SMT_BACKEND=auto
LLRE_Z3_TIMEOUT_MS=2000

# --- Shared Cross-OS Persistence ---
# Relative POSIX path (resolved via pathlib) for verified circuits discovered via self-play
LLRE_PRIMITIVE_LIB_PATH=data/primitive_library.json
